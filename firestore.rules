rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Somente a conta autenticada pode ler/registrar seu próprio aceite.
    match /user_consents/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['privacyVersion','termsVersion','acceptedAt'])
        && request.resource.data.keys().hasAll(['privacyVersion','termsVersion','acceptedAt'])
        && request.resource.data.privacyVersion == '2026-11-21'
        && request.resource.data.termsVersion == '2026-11-21'
        && request.resource.data.acceptedAt == request.time;
      allow delete: if false;
    }
    // Nenhuma coleção adicional aberta até serem desenvolvidos seus recursos.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
